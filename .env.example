# ── Server ──────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Secret used to sign the admin session cookie. CHANGE THIS.
SESSION_SECRET=change-me-to-a-long-random-string-please

# ── Database ────────────────────────────────────────────
# SQLite file (default). Swap the repository layer for Postgres in prod.
DB_FILE=./data/lucky-draw.db

# ── Default admin (created on first seed) ───────────────
ADMIN_EMAIL=info@alhashi.om
ADMIN_PASSWORD=demo1234
ADMIN_NAME=مدير مخيم الحاشي

# ── WhatsApp via Wasender API (https://wasenderapi.com) ──
# Leave WASENDER_API_KEY empty in dev to run in mock mode (messages are logged, not sent).
WASENDER_API_KEY=
WASENDER_BASE_URL=https://wasenderapi.com/api
